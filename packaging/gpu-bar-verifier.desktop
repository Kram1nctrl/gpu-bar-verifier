[Desktop Entry]
Type=Application
Version=1.1
Name=GPU Bar Verifier
GenericName=GPU Utilization Bar Tester
Comment=Load the discrete GPU and verify that its utilization bar follows reality
Exec=@EXEC@
TryExec=@EXEC@
Icon=gpu-bar-verifier
Terminal=false
Categories=System;Monitor;
Keywords=GPU;NVIDIA;Intel;AMD;utilization;usage;monitor;verify;test;bar;load;stress;prime;optimus;graphics;hardware;
StartupNotify=true
StartupWMClass=GpuBarVerifier
